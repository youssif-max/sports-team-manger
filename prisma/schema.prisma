generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("POSTGRES_PRISMA_URL")
  directUrl = env("POSTGRES_URL_NON_POOLING")
}

enum TeamType {
  CLUB
  SCHOOL
  RECREATIONAL
  TRAVEL
  OTHER
}

model Team {
  id             String           @id @default(cuid())
  name           String
  sport          String
  teamType       TeamType         @default(OTHER)
  season         String?
  colorPrimary   String?          @default("#1d4ed8")
  colorSecondary String?          @default("#0f172a")
  logoUrl        String?
  joinCode       String           @unique
  createdAt      DateTime         @default(now())
  memberships    TeamMembership[]
  events         Event[]
  announcements  Announcement[]
  chatMessages   ChatMessage[]
  highlights     Highlight[]
  statDefinitions StatDefinition[]
  plays          Play[]
  reports        Report[]
  auditLogs      AuditLog[]
  parentLinks    ParentLink[]
  joinRequests   JoinRequest[]

  // When true, joining with the code/link creates a request that an admin or
  // coach must approve instead of adding the person straight to the team.
  requireApproval Boolean @default(false)

  // Premium subscription (billed to the whole team, managed via Stripe)
  stripeCustomerId     String?   @unique
  stripeSubscriptionId String?   @unique
  stripePriceId        String?
  subscriptionStatus   String?
  currentPeriodEnd     DateTime?
}

model User {
  id                   String           @id @default(cuid())
  name                 String
  photoUrl             String?
  email                String?          @unique
  passwordHash         String?
  phone                String?
  dateOfBirth          DateTime?
  emailVerifiedAt      DateTime?
  termsAcceptedAt      DateTime?
  failedLoginAttempts  Int              @default(0)
  lockedUntil          DateTime?
  createdAt            DateTime         @default(now())

  // Two-factor authentication (TOTP). The secret is stored encrypted.
  totpSecretEnc        String?
  totpEnabledAt        DateTime?
  totpLastStep         Int?
  recoveryCodeHashes   String[]         @default([])
  loginChallenges      LoginChallenge[]
  joinRequests         JoinRequest[]

  emailTokens          EmailToken[]
  reportsMade          Report[]         @relation("ReportReporter")
  blocksMade           Block[]          @relation("Blocker")
  blocksReceived       Block[]          @relation("Blocked")
  auditActions         AuditLog[]
  childLinks           ParentLink[]     @relation("ParentOf")
  parentLinks          ParentLink[]     @relation("ChildOf")
  memberships          TeamMembership[]
  chatMessages         ChatMessage[]
  announcements        Announcement[]
  rsvps                Rsvp[]
  attendance           Attendance[]
  gameStats            GameStat[]
  highlights           Highlight[]        @relation("HighlightPlayer")
  postedHighlights     Highlight[]        @relation("HighlightPostedBy")
  plays                Play[]
  pushSubscriptions    PushSubscription[]
  sessions             Session[]
}

model Session {
  id        String   @id @default(cuid())
  token     String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  userAgent String?
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

// Created after a correct password for an account with 2FA on; the session is
// only issued once the second factor is also verified.
model LoginChallenge {
  id         String   @id @default(cuid())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId     String
  tokenHash  String   @unique
  redirectTo String?
  attempts   Int      @default(0)
  expiresAt  DateTime
  createdAt  DateTime @default(now())

  @@index([userId])
}

model JoinRequest {
  id        String   @id @default(cuid())
  team      Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  teamId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  role      Role
  createdAt DateTime @default(now())

  @@unique([teamId, userId])
  @@index([teamId])
}

enum EmailTokenType {
  VERIFY_EMAIL
  RESET_PASSWORD
  CLAIM_PROFILE
}

model EmailToken {
  id        String         @id @default(cuid())
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  type      EmailTokenType
  tokenHash String         @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime       @default(now())

  @@index([userId, type])
}

enum ReportTarget {
  CHAT_MESSAGE
  HIGHLIGHT
  ANNOUNCEMENT
}

enum ReportStatus {
  OPEN
  RESOLVED
  DISMISSED
}

model Report {
  id           String       @id @default(cuid())
  team         Team         @relation(fields: [teamId], references: [id], onDelete: Cascade)
  teamId       String
  reporter     User         @relation("ReportReporter", fields: [reporterId], references: [id], onDelete: Cascade)
  reporterId   String
  targetType   ReportTarget
  targetId     String
  targetUserId String?
  reason       String
  status       ReportStatus @default(OPEN)
  createdAt    DateTime     @default(now())

  @@index([teamId, status])
}

model Block {
  id        String   @id @default(cuid())
  blocker   User     @relation("Blocker", fields: [blockerId], references: [id], onDelete: Cascade)
  blockerId String
  blocked   User     @relation("Blocked", fields: [blockedId], references: [id], onDelete: Cascade)
  blockedId String
  createdAt DateTime @default(now())

  @@unique([blockerId, blockedId])
}

model AuditLog {
  id        String   @id @default(cuid())
  team      Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  teamId    String
  actor     User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  actorId   String?
  action    String
  detail    String?
  createdAt DateTime @default(now())

  @@index([teamId, createdAt])
}

// Links a parent/guardian account to a child's roster entry so they can see
// that one child's private details (and RSVP for them).
model ParentLink {
  id       String @id @default(cuid())
  team     Team   @relation(fields: [teamId], references: [id], onDelete: Cascade)
  teamId   String
  parent   User   @relation("ParentOf", fields: [parentId], references: [id], onDelete: Cascade)
  parentId String
  child    User   @relation("ChildOf", fields: [childId], references: [id], onDelete: Cascade)
  childId  String

  @@unique([teamId, parentId, childId])
}

model RateLimit {
  key     String   @id
  count   Int
  resetAt DateTime

  @@index([resetAt])
}

model PushSubscription {
  id        String   @id @default(cuid())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())
}

enum Role {
  ADMIN
  COACH
  PLAYER
  PARENT
}

model TeamMembership {
  id                     String    @id @default(cuid())
  team                   Team      @relation(fields: [teamId], references: [id], onDelete: Cascade)
  teamId                 String
  user                   User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId                 String
  role                   Role
  jerseyNumber           String?
  position               String?
  emergencyContactName   String?
  emergencyContactPhone  String?
  joinedAt               DateTime  @default(now())

  @@unique([teamId, userId])
}

enum EventType {
  PRACTICE
  GAME
  OTHER
}

model Event {
  id               String        @id @default(cuid())
  team             Team          @relation(fields: [teamId], references: [id], onDelete: Cascade)
  teamId           String
  type             EventType
  title            String
  startsAt         DateTime
  location         String?
  opponent         String?
  notes            String?
  recurringGroupId String?
  createdAt        DateTime      @default(now())
  attendance       Attendance[]
  rsvps            Rsvp[]
  gameStats        GameStat[]
  result           GameResult?
  highlights       Highlight[]

  @@index([recurringGroupId])
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  UNKNOWN
}

model Attendance {
  id      String            @id @default(cuid())
  event   Event             @relation(fields: [eventId], references: [id], onDelete: Cascade)
  eventId String
  user    User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId  String
  status  AttendanceStatus  @default(UNKNOWN)

  @@unique([eventId, userId])
}

enum RsvpStatus {
  IN
  OUT
  MAYBE
  PENDING
}

model Rsvp {
  id          String     @id @default(cuid())
  event       Event      @relation(fields: [eventId], references: [id], onDelete: Cascade)
  eventId     String
  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId      String
  status      RsvpStatus @default(PENDING)
  respondedAt DateTime?

  @@unique([eventId, userId])
}

model StatDefinition {
  id        String     @id @default(cuid())
  team      Team       @relation(fields: [teamId], references: [id], onDelete: Cascade)
  teamId    String
  name      String
  gameStats GameStat[]

  @@unique([teamId, name])
}

model GameStat {
  id               String         @id @default(cuid())
  event            Event          @relation(fields: [eventId], references: [id], onDelete: Cascade)
  eventId          String
  user             User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId           String
  statDefinition   StatDefinition @relation(fields: [statDefinitionId], references: [id], onDelete: Cascade)
  statDefinitionId String
  value            Float

  @@unique([eventId, userId, statDefinitionId])
}

enum Outcome {
  WIN
  LOSS
  TIE
}

model GameResult {
  id            String  @id @default(cuid())
  event         Event   @relation(fields: [eventId], references: [id], onDelete: Cascade)
  eventId       String  @unique
  teamScore     Int?
  opponentScore Int?
  outcome       Outcome
}

model Announcement {
  id        String   @id @default(cuid())
  team      Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  teamId    String
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  authorId  String
  title     String
  body      String
  createdAt DateTime @default(now())
}

model ChatMessage {
  id        String   @id @default(cuid())
  team      Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  teamId    String
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  authorId  String
  body      String
  createdAt DateTime @default(now())
}

model Highlight {
  id          String   @id @default(cuid())
  team        Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  teamId      String
  user        User?    @relation("HighlightPlayer", fields: [userId], references: [id], onDelete: SetNull)
  userId      String?
  postedBy    User?    @relation("HighlightPostedBy", fields: [postedById], references: [id], onDelete: SetNull)
  postedById  String?
  event       Event?   @relation(fields: [eventId], references: [id], onDelete: SetNull)
  eventId     String?
  title       String
  description String?
  videoUrl    String
  startSeconds Int?
  endSeconds   Int?
  createdAt   DateTime @default(now())

  @@index([postedById])
}

model Play {
  id          String   @id @default(cuid())
  team        Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  teamId      String
  title       String
  description String?
  diagram     String?  @db.Text
  thumbnail   String?  @db.Text
  fileUrl     String?
  createdBy   User?    @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdById String?
  createdAt   DateTime @default(now())
}
