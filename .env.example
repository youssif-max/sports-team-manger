# Copy to .env for local development. In production set these in Vercel
# (Project -> Settings -> Environment Variables). Never commit real values.

# --- Database (Neon) -------------------------------------------------------
DATABASE_URL=

# --- Email (Resend) — password reset, email confirmation, profile claims ---
RESEND_API_KEY=
EMAIL_FROM=SportSync <no-reply@yourdomain.com>   # domain must be verified in Resend
SUPPORT_EMAIL=                                    # shown on /support; gets report alerts

# --- Two-step verification -------------------------------------------------
# 32 random bytes, base64. Generate with:  openssl rand -base64 32
# REQUIRED in production for 2FA to be offered. Don't change it once users have
# enabled 2FA, or their authenticator secrets become unreadable.
TOTP_ENCRYPTION_KEY=

# --- Push notifications (web) ---------------------------------------------
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT_EMAIL=

# --- Stripe (Premium) -----------------------------------------------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_MONTHLY_ID=
STRIPE_PRICE_YEARLY_ID=

# --- Native apps (only used when running `npm run cap:sync`) ---------------
CAPACITOR_SERVER_URL=https://your-live-domain
